{
  "problem": "isValidSubsequence",
  "functionName": "isValidSubsequence",
  "goFunctionName": "IsValidSubsequence",
  "cases": [
    {
      "name": "valid subsequence from prompt",
      "args": [
        [5, 1, 22, 25, 6, -1, 8, 10],
        [1, 6, -1, 10]
      ],
      "expected": true
    },
    {
      "name": "wrong order in array",
      "args": [
        [5, 1, 22, 25, 6, -1, 8, 10],
        [6, 1, -1, 10]
      ],
      "expected": false
    },
    {
      "name": "empty sequence is always valid",
      "args": [[1, 2, 3], []],
      "expected": true
    },
    {
      "name": "sequence equals full array",
      "args": [[2, 4, 6], [2, 4, 6]],
      "expected": true
    },
    {
      "name": "single element found",
      "args": [[10, 20, 30], [20]],
      "expected": true
    },
    {
      "name": "single element missing",
      "args": [[10, 20, 30], [25]],
      "expected": false
    },
    {
      "name": "non-contiguous match",
      "args": [[1, 2, 3, 4, 5], [1, 3, 5]],
      "expected": true
    }
  ]
}
