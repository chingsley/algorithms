{
  "problem": "mergeOverlapingIntervals",
  "functionName": "mergeOverlappingIntervals",
  "goFunctionName": "mergeOverlappingIntervals",
  "cases": [
    {
      "name": "classic merge",
      "args": [
        [
          [
            1,
            2
          ],
          [
            3,
            5
          ],
          [
            4,
            7
          ],
          [
            6,
            8
          ],
          [
            9,
            10
          ]
        ]
      ],
      "expected": [
        [
          1,
          2
        ],
        [
          3,
          8
        ],
        [
          9,
          10
        ]
      ]
    },
    {
      "name": "touching intervals",
      "args": [
        [
          [
            1,
            2
          ],
          [
            2,
            3
          ]
        ]
      ],
      "expected": [
        [
          1,
          3
        ]
      ]
    },
    {
      "name": "single interval",
      "args": [
        [
          [
            1,
            5
          ]
        ]
      ],
      "expected": [
        [
          1,
          5
        ]
      ]
    },
    {
      "name": "unsorted overlapping intervals",
      "args": [
        [
          [2, 6],
          [1, 3],
          [8, 10],
          [15, 18]
        ]
      ],
      "expected": [
        [1, 6],
        [8, 10],
        [15, 18]
      ]
    },
    {
      "name": "touching endpoints",
      "args": [
        [
          [1, 4],
          [4, 5]
        ]
      ],
      "expected": [
        [1, 5]
      ]
    },
    {
      "name": "later interval starts first",
      "args": [
        [
          [4, 7],
          [1, 4]
        ]
      ],
      "expected": [
        [1, 7]
      ]
    }
  ]
}
